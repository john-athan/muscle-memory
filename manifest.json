{
  "manifest_version": 3,
  "name": "Muscle Memory",
  "version": "1.0.1",
  "description": "Gives your browser's shortcuts back on Figma, restores a real right-click, and lets the wheel scroll the way you expect.",
  "homepage_url": "https://github.com/john-athan/muscle-memory",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.figma.com/*"],
      "js": [
        "src/keymap.js",
        "src/settings.js",
        "src/selectors.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Muscle Memory",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
